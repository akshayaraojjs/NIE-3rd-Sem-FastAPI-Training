meta {
  name: 13 Admin Creates Ananya Iyer (unlinked)
  type: http
  seq: 13
}

post {
  url: {{base_url}}/students
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{admin_token}}
}

body:json {
  {
    "name": "Ananya Iyer",
    "age": 21,
    "course": "Data Science"
  }
}

script:post-response {
  if (res.status >= 200 && res.status < 300) {
    bru.setEnvVar("ananya_id", res.body.id);
  }
}

tests {
  test("Status is 201", function() {
    expect(res.status).to.equal(201);
  });
}

docs {
  13 Admin Creates Ananya Iyer (unlinked).
  Endpoint: POST {{base_url}}/students
}

settings {
  encodeUrl: true
  timeout: 0
}
