meta {
  name: 18 Admin Updates Aarav Malhotra
  type: http
  seq: 18
}

put {
  url: {{base_url}}/students/{{aarav_id}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{admin_token}}
}

body:json {
  {
    "age": 20,
    "course": "Artificial Intelligence"
  }
}

tests {
  test("Status is 200", function() {
    expect(res.status).to.equal(200);
  });
  test("Age updated", function() {
    expect(res.body.age).to.equal(20);
  });
}

docs {
  18 Admin Updates Aarav Malhotra.
  Endpoint: PUT {{base_url}}/students/{{aarav_id}}
}

settings {
  encodeUrl: true
  timeout: 0
}
