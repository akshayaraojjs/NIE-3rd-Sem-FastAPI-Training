meta {
  name: 15 Admin Creates Isha Nair (linked)
  type: http
  seq: 15
}

post {
  url: {{base_url}}/students
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{admin_token}}
}

body:json {
  {
    "name": "Isha Nair",
    "age": 21,
    "course": "Electronics",
    "user_id": "{{student2_user_id}}"
  }
}

script:post-response {
  if (res.status >= 200 && res.status < 300) {
    bru.setEnvVar("isha_id", res.body.id);
  }
}

tests {
  test("Status is 201", function() {
    expect(res.status).to.equal(201);
  });
}

docs {
  15 Admin Creates Isha Nair (linked).
  Endpoint: POST {{base_url}}/students
}

settings {
  encodeUrl: true
  timeout: 0
}
