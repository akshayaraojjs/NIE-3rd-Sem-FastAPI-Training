meta {
  name: 06 Register Student 3 (Kabir)
  type: http
  seq: 6
}

post {
  url: {{base_url}}/users
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "username": "kabir_student",
    "password": "kabir@123",
    "role": 3
  }
}

script:post-response {
  if (res.status >= 200 && res.status < 300) {
    bru.setEnvVar("kabir_user_id", res.body.id);
  }
}

tests {
  test("Role is student", function() {
    expect(res.body.role).to.equal(3);
  });
}

docs {
  06 Register Student 3 (Kabir).
  Endpoint: POST {{base_url}}/users
}

settings {
  encodeUrl: true
  timeout: 0
}
