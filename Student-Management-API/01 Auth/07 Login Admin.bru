}

body:text {
  username=aarav_admin&password=aarav%40123
}

script:post-response {
  if (res.status >= 200 && res.status < 300) {
    bru.setEnvVar("admin_token", res.body.access_token);
  }
}

tests {
  test("Status is 200", function() {
    expect(res.status).to.equal(200);
  });
}

